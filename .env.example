FLASK_APP=run.py
FLASK_DEBUG=1
# development | testing | production
APP_ENV=development
SECRET_KEY=change-me
# Defaults to instance/business_scraper.db when unset
# DATABASE_URL=sqlite:////absolute/path/to/business_scraper.db
LOG_LEVEL=INFO

# Address lookup (OpenStreetMap Nominatim). Put your email in the User-Agent per their usage policy.
GEOCODER_USER_AGENT=BusinessScraper/1.0 (local dashboard)
GEOCODER_COUNTRY_CODES=ge
GEOCODER_LANGUAGE=ka,en

# "google_maps" scrapes in a real browser; "fake" generates sample data for development.
SCRAPER_PROVIDER=google_maps
SCRAPER_LANGUAGE=ka
FAKE_SCRAPER_DELAY=0.5
# Keep at 1: one browser profile, one search at a time, like one person.
JOB_RUNNER_WORKERS=1

# Google Maps pacing. A visible window looks more like a person and lets you solve a CAPTCHA.
SCRAPER_HEADLESS=false
# Set to "chrome" after installing Google Chrome to use it instead of bundled Chromium.
# SCRAPER_BROWSER_CHANNEL=chrome
SCRAPER_PLACE_DELAY_MIN=4
SCRAPER_PLACE_DELAY_MAX=9
SCRAPER_SEARCH_COOLDOWN=90
SCRAPER_DAILY_PLACE_LIMIT=300
SCRAPER_CAPTCHA_WAIT=300
SCRAPER_BLOCK_BACKOFF_HOURS=6

# Social media lookup: pause between website downloads, and how long to wait for one.
SOCIAL_PAGE_DELAY_MIN=1.5
SOCIAL_PAGE_DELAY_MAX=4
SOCIAL_FETCH_TIMEOUT=8

# Sending email: connect your Gmail on the Settings page (it's saved to instance/mail_settings.json,
# not here). Only change these to use another provider's SMTP-over-SSL server.
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465
